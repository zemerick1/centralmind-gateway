# ============================================
# CentralMind Gateway Configuration
# ============================================

# --- CentralMind MCP Server ---
# Command to start your central-mind MCP server (copy from your claude_desktop_config.json)
# Example for local development:
CENTRALMIND_COMMAND="python -m centralmind"

# Timeout for MCP tool calls (seconds)
MCP_TIMEOUT=60

# --- LLM Configuration (LiteLLM) ---
# Recommended starting point: Grok (fast + capable)
LLM_MODEL="xai/grok-3-latest"
XAI_API_KEY="xai-your-key-here"

# Alternative: Gemini (great free tier)
# LLM_MODEL="gemini/gemini-2.5-flash"
# GOOGLE_API_KEY="your-google-key"

# Alternative: Claude (if you have access)
# LLM_MODEL="anthropic/claude-3-5-sonnet-20241022"
# ANTHROPIC_API_KEY="sk-ant-..."

# Temperature for LLM responses (0.0 = deterministic, 0.7 = creative)
LLM_TEMPERATURE=0.3

# Max tokens for LLM responses
LLM_MAX_TOKENS=4000

# --- Output Destinations ---
# Primary webhook (your Teams example)
OUTPUT_WEBHOOK_URL="https://your-tenant.webhook.office.com/webhookb2/43f6730d-2bd8-4af6-bc6f-52716f417051@7d44fc5a-ab19-4560-ab7d-99875468d1bd/IncomingWebhook/fa227089070946c197d2bcf3608888f4/f14d5d4f-39dd-4cd7-86a7-5e5728a0824e"

# Optional Slack Incoming Webhook (replace with your real one if using)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WORKSPACE/TOKEN"

# Optional: Default channel name for Slack (if using Slack SDK instead of webhook)
# SLACK_CHANNEL="#network-alerts"

# --- Safety & Behavior ---
# Must match your central-mind .env (readonly recommended)
CENTRALMIND_API_MODE=readonly

# Log level (DEBUG shows every LLM thought and tool call — very useful)
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000

# API Key for protecting the gateway endpoints (optional but recommended)
# GATEWAY_API_KEY="super-secret-key-here"
