# ===========================================
# CentralMind Gateway Environment Variables
# ===========================================

# --- CentralMind MCP Server ---
# Command used to start the centralmind MCP server.
# In Docker Compose this should stay as "centralmind".
# When running natively you may need "uv run centralmind".
CENTRALMIND_COMMAND=centralmind

# --- LLM Configuration ---
# Model to use for investigation (LiteLLM format)
LLM_MODEL=xai/grok-4.3

# Your LLM provider API key (example for xAI)
# XAI_API_KEY=your_xai_api_key_here

# Optional: Temperature for LLM responses (0.0 - 1.0)
# LLM_TEMPERATURE=0.2

# Optional: Max tokens for LLM responses
# LLM_MAX_TOKENS=4000

# --- Logging ---
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Notification Destinations ---
# Default behavior is to log the final notification.
# Set one of the following to also deliver externally.

# Primary webhook (Teams, Slack-compatible, or custom)
# OUTPUT_WEBHOOK_URL=https://your-webhook-url-here

# Optional dedicated Slack webhook
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Server Settings ---
# Host and port the gateway listens on
HOST=0.0.0.0
PORT=8001